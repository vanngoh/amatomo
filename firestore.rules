rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Only the single demo room is accessible, and only to signed-in users.
    match /rooms/demo {
      allow read, write: if request.auth != null;
      match /{sub=**} {
        allow read, write: if request.auth != null;
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
